# Telegram bot token from BotFather. Never commit the real token.
BOT_TOKEN=

# Telegram numeric user IDs allowed to approve/reject access requests.
# Comma-separated, e.g. 123456789,987654321
ADMIN_TELEGRAM_IDS=

# GitHub App credentials. Install the App only on Zuno-inc/Zuno.
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_INSTALLATION_ID=
GITHUB_OWNER=Zuno-inc
GITHUB_REPO=Zuno

# SQLite database path. Render persistent disk: /var/data/requests.sqlite
DATABASE_PATH=./data/requests.sqlite

# Optional: public project URL shown in /rules
PROJECT_URL=https://zuno-com.onrender.com/
