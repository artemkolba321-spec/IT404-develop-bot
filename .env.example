# Telegram bot token from BotFather. Never commit the real token.
BOT_TOKEN=

# GitHub App credentials. Install the App only on Zuno-inc/Zuno.
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_INSTALLATION_ID=
GITHUB_OWNER=Zuno-inc
GITHUB_REPO=Zuno

# Render webhook settings. WEBHOOK_URL is https://YOUR-SERVICE.onrender.com/telegram
WEBHOOK_URL=
# Use a random 1-256 character value containing only A-Z, a-z, 0-9, _ or -.
WEBHOOK_SECRET=

# Optional: public project URL shown in /rules
PROJECT_URL=https://zuno-com.onrender.com/
